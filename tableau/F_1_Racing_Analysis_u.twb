      <aliases enabled='yes' />
      <column caption='Win Flag' datatype='integer' name='[Calculation_0369496427642880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [finish_position] = 1 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Podium Flag' datatype='integer' name='[Calculation_0369496427966465]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF IFNULL([finish_position],99) &lt;= 3 THEN 1 ELSE 0 END' />
      </column>
      <column caption='DNF Rate%' datatype='real' name='[Calculation_0369496428146690]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dnf]) / COUNT([driver])' />
      </column>
      <column caption='Weather Type' datatype='string' name='[Calculation_0369496428326915]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_wet_race] = 1 THEN &quot;Wet&quot; ELSE &quot;Dry&quot; END' />
      </column>
      <column caption='Pit Stop Category' datatype='string' name='[Calculation_0369496428535812]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [avg_pit_stop_time_s] &lt; 22 THEN &quot;Fast&quot; ELSEIF [avg_pit_stop_time_s] &lt; 25 THEN &quot;Average&quot; ELSE &quot;Slow&quot; END' />
      </column>
      <column caption='Points Per Race' datatype='real' name='[Calculation_0369496428806149]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([points]) / COUNTD([race_id])' />
      </column>
